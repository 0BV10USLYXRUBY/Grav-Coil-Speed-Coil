-- Helper for Gravity Coil (Gravity: 80, JumpPower: 70)
local function setupGravityCoil(tool)
    local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    tool.Equipped:Connect(function()
        Workspace.Gravity = 80
        if humanoid then
            humanoid.UseJumpPower = true
            humanoid.JumpPower = 70
        end
    end)

    tool.Unequipped:Connect(function()
        Workspace.Gravity = 196.2
        if humanoid then
            humanoid.JumpPower = 50
        end
    end)
end

-- Helper for Speed Coil (WalkSpeed: 80)
local function setupSpeedCoil(tool)
    local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    tool.Equipped:Connect(function()
        if humanoid then
            humanoid.WalkSpeed = 80
        end
    end)

    tool.Unequipped:Connect(function()
        if humanoid then
            humanoid.WalkSpeed = 16
        end
    end)
end

-- Function to load gears safely
local function giveGear(gearId, coilType)
    task.spawn(function()
        local success, err = pcall(function()
            local assets = game:GetObjects("rbxassetid://" .. gearId)
            for _, asset in ipairs(assets) do
                local tool = nil
                if asset:IsA("Tool") then
                    tool = asset
                else
                    tool = asset:FindFirstChildWhichIsA("Tool", true)
                end
                
                if tool then
                    if coilType == "GC" then
                        setupGravityCoil(tool)
                    elseif coilType == "SC" then
                        setupSpeedCoil(tool)
                    end
                    tool.Parent = localPlayer.Backpack
                else
                    asset.Parent = localPlayer.Backpack
                end
            end
        end)
        if not success then
            warn("Failed to load gear ID " .. gearId .. ": " .. tostring(err))
        end
    end)
end

